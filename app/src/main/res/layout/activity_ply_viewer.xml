<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full screen GL view -->
    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: back button + point count -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#AA000000"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#44FFFFFF" />

        <TextView
            android:id="@+id/tvPointCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:visibility="visible" />

    </RelativeLayout>

    <!-- Measure hint — top center, below top bar -->
    <TextView
        android:id="@+id/tvMeasureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:background="#AA000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Result text — shows distance OR angle, center bottom -->
    <TextView
        android:id="@+id/tvDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btnRow"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="#CC000000"
        android:padding="10dp"
        android:textColor="#FFEB3B"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom button row: Measure | Angle -->
    <LinearLayout
        android:id="@+id/btnRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tvBottomHint"
        android:layout_alignParentStart="true"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMeasure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Measure"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3" />

        <Button
            android:id="@+id/btnAngle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Angle"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D9E75" />

    </LinearLayout>

    <!-- Bottom hint bar -->
    <TextView
        android:id="@+id/tvBottomHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#AA000000"
        android:padding="8dp"
        android:gravity="center"
        android:textColor="#AAFFFFFF"
        android:textSize="12sp" />

</RelativeLayout>